generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Editorial byline identity (distinct from auth User — Master Reqs §7.1 authors).
model Author {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  role          String
  avatar        String?
  bio           String?
  credentials   String?
  editorialBeat String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  articles      Article[]
}

/// One of the five approved primary sections (and future sub-sections).
model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String    @unique
  description String?
  sortOrder   Int       @default(0)
  articles    Article[]
  /// Batch 04-B — the managed second level inside this primary section.
  subcategories Subcategory[]
}

/// Batch 04-B — managed Subcategory taxonomy.
///
/// A curated second level that belongs to exactly ONE primary section
/// (`Category`). It is deliberately separate from the other classification
/// axes: Article Type is a code-level typology (Batch 04-A), `Tag` is open
/// many-to-many keywords, and `Discipline` is which rodeo event — with its own
/// Roughstock/Timed Event classification from Issue 03.
///
/// WHY A TABLE, when Article Type stays in code: nothing branches on a
/// subcategory, so an editor adding one cannot strand a code path. The audit
/// measured the opposite for Article Type, which is why only this axis is
/// database-managed.
///
/// Slugs are unique WITHIN the parent, following the existing
/// `RodeoEventEdition.@@unique([eventId, editionSlug])` precedent: the intended
/// public route is nested (`/categories/<cat>/<sub>/`), so global uniqueness is
/// not required and would needlessly forbid "Tickets" under two sections.
/// Choosing a FLAT route later would need a global unique added after rows
/// exist — a migration that can fail on real data. No public route exists yet.
model Subcategory {
  id          String    @id @default(uuid())
  categoryId  String
  name        String
  /// GLOBALLY unique, not per-parent.
  ///
  /// The owner chose a flat public route — `/<subcategory>/` for the archive and
  /// `/<subcategory>/<article>/` for an article inside it — so the slug alone has
  /// to identify the row. The original spec (Issue 04 §1.3) specified
  /// `@@unique([categoryId, slug])` precisely because a FLAT route would need
  /// this constraint added later, "a migration that can fail on real data". It
  /// did not fail: production held 14 subcategories with zero cross-section slug
  /// collisions when the constraint was added.
  ///
  /// One consequence, and it is permanent: "Tickets" can no longer exist under
  /// two sections at once. A second section wanting that name needs a distinct
  /// slug (`nfr-tickets`, `vegas-tickets`).
  slug        String    @unique
  description String?
  /// Below here: the Discipline-grade landing-page content. A subcategory archive
  /// is a real entity page now, so it carries the same editorial surface a
  /// discipline guide does rather than being a bare list of links.
  summary     String?
  image       String?
  imageCredit String?
  guide       Json?
  sortOrder   Int       @default(0)
  /// Archive lifecycle, matching the Discipline convention: nullable with NO
  /// default, so every row reads as ACTIVE and the migration rewrites nothing.
  /// Archiving preserves existing article links; it only withdraws the
  /// subcategory from new assignment.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  articles    Article[] @relation("ArticleSubcategory")

  @@unique([categoryId, name])
  /// Not redundant: this is the TARGET of Article's composite foreign key
  /// below. PostgreSQL requires a unique constraint on the referenced column
  /// pair, and `id` alone being unique is not enough for a two-column FK.
  @@unique([categoryId, id])
  @@index([categoryId, sortOrder])
  @@index([archivedAt])
}

model Tag {
  id       String       @id @default(uuid())
  slug     String       @unique
  name     String
  articles ArticleTag[]
}

/// Batch 04-E — the MANAGED Article Type definition.
///
/// Batch 04-A made `lib/content/articleTypes.ts` the one authoritative registry
/// after finding seven competing vocabularies. That registry stays in the
/// repository as the immutable BOOTSTRAP + FALLBACK definition; this table is
/// what administrators edit, and it wins whenever it holds rows.
///
/// WHY NO FOREIGN KEY FROM `Article`. `Article.articleType` keeps its existing
/// `String` column, unchanged and unrewritten. A FK would have to be satisfied
/// by every one of the existing rows the instant it is created, which means
/// rewriting data as part of a schema change — exactly what this programme
/// forbids. Integrity is instead enforced where it is cheap and reversible: the
/// service refuses to delete or hard-remove a value any article still stores.
model ArticleType {
  id          String            @id @default(uuid())
  /// The IMMUTABLE stored identity — byte-for-byte what `Article.articleType`
  /// holds. Never rewritten, never renamed; the display label carries change.
  /// Exact-unique, and deliberately NOT case-folded.
  ///
  /// A case-folded unique constraint was the first design, and the data refused
  /// it: the compatibility vocabulary contains BOTH `News` (the current
  /// selectable typology) and `news` (a legacy value six articles-worth of
  /// history stores). They are two distinct stored strings, each held by real
  /// rows, so a constraint on `lower(value)` cannot express this column —
  /// it would have made one of the 23 definitions unrepresentable.
  ///
  /// Case-collision is therefore refused by `articleTypeService` at CREATE,
  /// where the policy actually applies: an administrator may not add a variant
  /// of a value that already exists. The pre-existing `News`/`news` pair is
  /// grandfathered by the bootstrap, which writes exact values directly.
  value       String            @unique
  label       String
  description String?
  sortOrder   Int               @default(0)
  /// Offered for NEW classification. False keeps the value fully readable and
  /// editable on the articles that already store it.
  selectable  Boolean           @default(true)
  evergreen   Boolean           @default(false)
  /// The SINGLE authoritative structured-data classification. Deliberately not
  /// a `news` boolean beside an `Article`/`NewsArticle` field: two overlapping
  /// SEO flags are two things to disagree, and this is the one setting that
  /// changes what search engines are told about a published page.
  schemaType  ArticleSchemaType @default(ARTICLE)
  /// Archive lifecycle, same convention as Subcategory and Discipline:
  /// nullable with NO default, so every bootstrapped row reads as ACTIVE.
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  @@index([sortOrder])
  @@index([selectable])
  @@index([archivedAt])
}

/// Supported structured-data classifications for an Article Type. A constrained
/// enum rather than free text: an unrecognised value must never be able to
/// reach `articleJsonLd`, and `NewsArticle` must never be reachable by accident.
enum ArticleSchemaType {
  ARTICLE
  NEWS_ARTICLE
}

model Article {
  id                  String                         @id @default(uuid())
  slug                String                         @unique
  title               String
  deck                String?
  excerpt             String
  imageSeoTitle       String?
  imageAltText        String?
  subcategory         String?
  /// Batch 04-B — the MANAGED subcategory. Nullable by design (optional), and
  /// NULL for every existing row, so the migration rewrites nothing. The legacy
  /// `subcategory` text column above is deliberately preserved and untouched.
  subcategoryId       String?
  articleType         String
  workflowStatus      WorkflowStatus                 @default(DRAFT)
  readTime            String?
  wordCount           Int?
  isLeadHero          Boolean                        @default(false)
  isFeatured          Boolean                        @default(false)
  heroImageUrl        String?
  imageCredit         String?
  imageCaption        String?
  imageRightsStatus   ImageRightsStatus              @default(UNRESOLVED)
  disclosureType      String                         @default("editorial-independent")
  disclosureNote      String?
  takeaways           String[]                       @default([])
  publishedAt         DateTime?
  scheduledAt         DateTime?
  reviewedAt          DateTime?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  authorId            String
  categoryId          String
  createdById         String?
  version             Int                            @default(1)
  searchVector        Unsupported("tsvector")?       @default(dbgenerated("((((setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(deck, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(excerpt, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(subcategory, ''::text)), 'C'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(\"articleType\", ''::text)), 'C'::\"char\"))"))
  affiliatePlacements AffiliatePlacement[]
  competitors         ArticleCompetitor[]
  author              Author                         @relation(fields: [authorId], references: [id])
  category            Category                       @relation(fields: [categoryId], references: [id])
  /// Batch 04-B — COMPOSITE foreign key: (categoryId, subcategoryId) must match
  /// a Subcategory's (categoryId, id). PostgreSQL therefore REFUSES a
  /// subcategory belonging to another primary section — the invariant is
  /// structural, not dependent on every future code path remembering it. The
  /// service validates first so an editor sees a sentence, not a constraint.
  ///
  /// Named `subcategoryTaxon` because the legacy string column already owns the
  /// name `subcategory`; renaming that column mid-transition would be breaking,
  /// so the rename belongs to a later clean-up migration.
  ///
  /// `onDelete: Restrict` is the final boundary behind the service's
  /// "cannot delete while articles reference it" check.
  ///
  /// `onUpdate: Restrict` matters more than it looks. Prisma's default is
  /// CASCADE, which would mean that moving a Subcategory to another primary
  /// section silently rewrote the `categoryId` of every article using it —
  /// relocating published articles between sections as a side effect of a
  /// taxonomy edit. RESTRICT makes the database refuse that move while any
  /// article references the subcategory, which is exactly the rule the service
  /// enforces with a readable message.
  ///
  /// NULL semantics are deliberate: a multi-column FK is MATCH SIMPLE, so when
  /// `subcategoryId` is NULL the constraint does not apply at all. That is what
  /// keeps the subcategory genuinely optional.
  subcategoryTaxon    Subcategory?                   @relation("ArticleSubcategory", fields: [categoryId, subcategoryId], references: [categoryId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy           User?                          @relation("ArticleCreatedBy", fields: [createdById], references: [id])
  blocks              ArticleBlock[]
  disciplines         ArticleDiscipline[]
  editions            ArticleEdition[]
  events              ArticleEvent[]
  hubs                ArticleHub[]
  media               ArticleMedia[]
  relatedTo           ArticleRelation[]              @relation("ArticleRelationSource")
  relatedFrom         ArticleRelation[]              @relation("ArticleRelationTarget")
  revisions           ArticleRevision[]
  seo                 ArticleSeo?
  sources             ArticleSource[]
  tags                ArticleTag[]
  workflow            EditorialWorkflowHistory[]
  seoFindings         SeoFinding[]
  sponsorships        SponsoredContentRelationship[]
  comments            ArticleComment[]

  @@index([workflowStatus])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([publishedAt])
  @@index([workflowStatus, publishedAt])
  @@index([searchVector], type: Gin)
}

/// Curated article-to-article relationships (replaces relatedArticleIds JSON).
model ArticleRelation {
  sourceId String
  targetId String
  source   Article @relation("ArticleRelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target   Article @relation("ArticleRelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId])
}

/// Structured article body. JSON `data` is justified: block shapes are a flexible
/// discriminated union; blockType + sortOrder stay queryable columns.
model ArticleBlock {
  id        String  @id @default(uuid())
  articleId String
  sortOrder Int
  blockType String
  data      Json
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, sortOrder])
  @@index([articleId])
}

/// Per-article SEO payload (Master Reqs §5 / Batch 02 §4 ArticleSEO).
model ArticleSeo {
  id                 String  @id @default(uuid())
  articleId          String  @unique
  seoTitle           String?
  metaDescription    String?
  canonicalUrl       String?
  ogImage            String?
  robots             String  @default("index, follow")
  structuredDataType String  @default("Article")
  article            Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ArticleRevision {
  id         String         @id @default(uuid())
  articleId  String
  revisionNo Int
  actorName  String
  actorRole  String
  status     WorkflowStatus
  summary    String
  snapshot   Json
  createdAt  DateTime       @default(now())
  actorId    String?
  actor      User?          @relation(fields: [actorId], references: [id])
  article    Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, revisionNo])
  @@index([articleId, createdAt])
}

/// Workflow state transition log (distinct from content revisions).
model EditorialWorkflowHistory {
  id         String          @id @default(uuid())
  articleId  String
  fromStatus WorkflowStatus?
  toStatus   WorkflowStatus
  actorName  String
  note       String?
  createdAt  DateTime        @default(now())
  actorId    String?
  actor      User?           @relation(fields: [actorId], references: [id])
  article    Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

/// Reusable source directory.
model Source {
  id               String               @id @default(uuid())
  title            String
  url              String
  publisher        String?
  type             String?
  classification   SourceClassification @default(INDEPENDENT_REFERENCE)
  status           SourceStatus         @default(NEEDS_REVIEW)
  verificationDate DateTime?
  articles         ArticleSource[]

  @@index([status])
}

model ArticleSource {
  articleId String
  sourceId  String
  note      String?
  sortOrder Int     @default(0)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source    Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([articleId, sourceId])
}

/// Digital asset (Batch 05). Binaries live in object storage (`storageProvider` +
/// `storageKey`); Postgres holds only metadata/relationships/lifecycle. Legacy
/// seeded rows use provider `legacy-local` and keep their `/assets/...` url.
model MediaAsset {
  id                  String                   @id @default(uuid())
  storageKey          String                   @unique
  url                 String
  filename            String
  mimeType            String?
  dimensions          String?
  bytes               Int?
  format              String?
  seoTitle            String?
  altText             String?
  credit              String?
  rightsStatus        ImageRightsStatus        @default(UNRESOLVED)
  uploadedAt          DateTime                 @default(now())
  caption             String?
  checksum            String?
  copyrightHolder     String?
  derivatives         Json?
  extension           String?
  height              Int?
  licenseSourceUrl    String?
  licenseType         MediaLicenseType         @default(UNCONFIRMED)
  processingStatus    MediaProcessingStatus    @default(READY)
  rightsConfirmed     Boolean                  @default(false)
  rightsConfirmedAt   DateTime?
  rightsConfirmedById String?
  safeFilename        String?
  sourceAttribution   String?
  storageProvider     String                   @default("legacy-local")
  title               String?
  updatedAt           DateTime                 @default(now()) @updatedAt
  uploadedById        String?
  usageRestrictions   String?
  visibility          MediaVisibility          @default(PUBLIC)
  width               Int?
  articles            ArticleMedia[]
  disciplines         DisciplineMedia[]
  competitors         CompetitorMedia[]
  uploadedBy          User?                    @relation("MediaUploader", fields: [uploadedById], references: [id])
  editions            RodeoEventEditionMedia[]
  events              RodeoEventMedia[]
  hubs                RodeoHubMedia[]
  venues              VenueMedia[]
  /// Pages using this asset as their hero (PM-03).
  infoPageHeroes      InfoPage[]               @relation("InfoPageHero")

  @@index([visibility, processingStatus])
  @@index([uploadedById])
  @@index([checksum])
}

model RodeoHubMedia {
  hubId     String
  mediaId   String
  role      String     @default("gallery")
  sortOrder Int        @default(0)
  hub       RodeoHub   @relation(fields: [hubId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([hubId, mediaId])
  @@index([mediaId])
}

model RodeoEventMedia {
  eventId   String
  mediaId   String
  role      String     @default("gallery")
  sortOrder Int        @default(0)
  event     RodeoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([eventId, mediaId])
  @@index([mediaId])
}

model RodeoEventEditionMedia {
  editionId String
  mediaId   String
  role      String            @default("gallery")
  sortOrder Int               @default(0)
  edition   RodeoEventEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  media     MediaAsset        @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([editionId, mediaId])
  @@index([mediaId])
}

model DisciplineMedia {
  disciplineId String
  mediaId      String
  role         String     @default("gallery")
  sortOrder    Int        @default(0)
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  media        MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([disciplineId, mediaId])
  @@index([mediaId])
}

model VenueMedia {
  venueId   String
  mediaId   String
  role      String     @default("gallery")
  sortOrder Int        @default(0)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([venueId, mediaId])
  @@index([mediaId])
}

model ArticleMedia {
  articleId String
  mediaId   String
  usageKey  String
  altText   String?
  caption   String?
  sortOrder Int        @default(0)
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([articleId, usageKey])
  @@index([mediaId])
}

/// The seven NFR disciplines. Rich evergreen guide body stored as JSON (`guide`)
/// — a flexible nested structure that does not benefit from further tables yet.
model Discipline {
  id          String                 @id @default(uuid())
  slug        String                 @unique
  name        String
  shortName   String?
  /// LEGACY classification text, deliberately preserved and never rewritten.
  ///
  /// Dynamic Discipline Classification replaced this as the source of truth with
  /// `classificationId` below, but the column stays: it is what every existing
  /// row holds, what the full-text `searchVector` already indexes, and what the
  /// application reads if the classification table is absent. Exactly the
  /// transition shape Batch 04-B used for `Article.subcategory`.
  category    String?
  /// Batch 05 — the MANAGED classification. Nullable by design: a discipline
  /// need not be classified, and the backfill attaches rows without ever
  /// requiring one.
  ///
  /// A foreign key to a STABLE id, not the display name. This is the whole point
  /// of the change: renaming "Timed Event" now rewrites one row in one table and
  /// every discipline follows it, where previously the name WAS the relationship
  /// key and a rename orphaned every discipline still holding the old string.
  classificationId String?
  /// `onDelete: Restrict` is the deletion guard, enforced by PostgreSQL rather
  /// than only by the service: a classification that any discipline still
  /// references cannot be deleted, however the delete is attempted.
  classification   DisciplineClassification? @relation("DisciplineClassificationAssignment", fields: [classificationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tagline     String?
  summary     String
  image       String?
  imageCredit String?
  guide       Json?
  sortOrder   Int                    @default(0)
  articles    ArticleDiscipline[]
  media       DisciplineMedia[]
  events      EventDiscipline[]
  competitors CompetitorDiscipline[]
  compSessions CompetitionSession[]
  compResults  CompetitionResult[]
  compStandings CompetitionStanding[]
  /// Archive lifecycle (owner-approved, Rodeo Coverage lifecycle workstream).
  /// Nullable with no default: every existing row reads as ACTIVE, so the
  /// migration rewrites nothing. Archiving sets a timestamp; reactivating sets
  /// it back to NULL. Archive is NOT publication state - an archived entity
  /// keeps its detail URL at HTTP 200 with noindex, and leaves active listings
  /// and the sitemap.
  archivedAt  DateTime?

  @@index([archivedAt])
  @@index([classificationId])
}

/// Batch 05 — the MANAGED Discipline Classification vocabulary.
///
/// How a rodeo discipline is contested: judged rides on bucking stock, or
/// fastest time. Previously a fixed pair written into the code in six places;
/// now administrator-managed rows, on the owner's approval.
///
/// NOT the editorial Category taxonomy. `Category` rows organise ARTICLES into
/// the five navigation sections; these rows classify DISCIPLINES. The two
/// models stay separate, and `Discipline` carries no second relation to
/// `Category`.
model DisciplineClassification {
  id          String   @id @default(uuid())
  /// The IMMUTABLE machine identity. Set once at creation and never editable,
  /// so a rename cannot break a reference.
  ///
  /// For the two pre-existing classifications it is byte-for-byte the legacy
  /// `Discipline.category` text ("Roughstock", "Timed Event"), which is what
  /// lets the backfill match existing rows exactly without rewriting any of
  /// them, and what lets the application fall back to the legacy column when
  /// this table is absent.
  value       String   @unique
  /// The display name. Mutable — this is what a rename changes.
  name        String
  /// URL-safe form, unique. Reserved for a future public route; nothing routes
  /// on it yet, so renaming `name` without touching `slug` breaks no URL.
  slug        String   @unique
  /// Plural wording for the public Competition filter button, which reads as a
  /// group ("Timed Events") while `name` names one discipline's classification
  /// ("Timed Event"). Nullable: it falls back to `name`, so an administrator
  /// who does not care never has to think about it.
  pluralName  String?
  description String?
  sortOrder   Int      @default(0)
  /// Offered for NEW assignment. False leaves every discipline already
  /// classified by it fully readable, editable and publicly filterable —
  /// the same convention as `ArticleType.selectable`.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  disciplines Discipline[] @relation("DisciplineClassificationAssignment")

  @@index([sortOrder])
  @@index([active])
}

model RodeoHub {
  id                String          @id @default(uuid())
  slug              String          @unique
  title             String
  region            String?
  circuitType       String?
  description       String?
  annualEventsCount Int             @default(0)
  sortOrder         Int             @default(0)
  articles          ArticleHub[]
  hubEvents         RodeoHubEvent[]
  media             RodeoHubMedia[]
  /// Archive lifecycle (owner-approved, Rodeo Coverage lifecycle workstream).
  /// Nullable with no default: every existing row reads as ACTIVE, so the
  /// migration rewrites nothing. Archiving sets a timestamp; reactivating sets
  /// it back to NULL. Archive is NOT publication state - an archived entity
  /// keeps its detail URL at HTTP 200 with noindex, and leaves active listings
  /// and the sitemap.
  archivedAt  DateTime?

  @@index([archivedAt])
}

/// Stable recurring event identity, independent of any hub (Master Reqs §2.1).
model RodeoEvent {
  id               String              @id @default(uuid())
  slug             String              @unique
  name             String
  location         String?
  traditionalMonth String?
  status           String?
  description      String?
  organizerName    String?
  officialUrl      String?
  isFlagship       Boolean             @default(false)
  articles         ArticleEvent[]
  editions         RodeoEventEdition[]
  media            RodeoEventMedia[]
  hubLinks         RodeoHubEvent[]
  /// Archive lifecycle (owner-approved, Rodeo Coverage lifecycle workstream).
  /// Nullable with no default: every existing row reads as ACTIVE, so the
  /// migration rewrites nothing. Archiving sets a timestamp; reactivating sets
  /// it back to NULL. Archive is NOT publication state - an archived entity
  /// keeps its detail URL at HTTP 200 with noindex, and leaves active listings
  /// and the sitemap.
  archivedAt  DateTime?

  @@index([archivedAt])
}

/// Curated hub ↔ recurring-event association (Batch 10). A hub lists its associated
/// events without owning them — the event URL is hub-independent (Master Reqs:
/// "hub association does not change event URL"). Additive M:N join.
model RodeoHubEvent {
  hubId     String
  eventId   String
  sortOrder Int        @default(0)
  event     RodeoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hub       RodeoHub   @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@id([hubId, eventId])
  @@index([eventId])
}

/// Specific occurrence/year. Unique per (eventId, editionSlug) — Master Reqs §7.2.
model RodeoEventEdition {
  id             String                    @id @default(uuid())
  eventId        String
  editionSlug    String
  label          String
  year           Int?
  startAt        DateTime?
  endAt          DateTime?
  timezone       String?
  purseBenchmark String?
  venueId        String?
  articles       ArticleEdition[]
  event          RodeoEvent                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue          Venue?                    @relation(fields: [venueId], references: [id])
  media          RodeoEventEditionMedia[]
  competitors    CompetitorParticipation[]
  sessions       CompetitionSession[]
  results        CompetitionResult[]
  standings      CompetitionStanding[]
  /// Archive lifecycle (owner-approved, Rodeo Coverage lifecycle workstream).
  /// Nullable with no default: every existing row reads as ACTIVE, so the
  /// migration rewrites nothing. Archiving sets a timestamp; reactivating sets
  /// it back to NULL. Archive is NOT publication state - an archived entity
  /// keeps its detail URL at HTTP 200 with noindex, and leaves active listings
  /// and the sitemap.
  archivedAt  DateTime?

  @@unique([eventId, editionSlug])
  @@index([archivedAt])
}

model Venue {
  id          String              @id @default(uuid())
  slug        String              @unique
  name        String
  nickname    String?
  summary     String?
  description String?
  websiteUrl  String?
  capacity    Int?
  openedYear  Int?
  latitude    Float?
  longitude   Float?
  city        String?
  state       String?
  country     String?
  sortOrder   Int                 @default(0)
  editions    RodeoEventEdition[]
  media       VenueMedia[]
  compSessions CompetitionSession[]
  /// Archive lifecycle (owner-approved, Rodeo Coverage lifecycle workstream).
  /// Nullable with no default: every existing row reads as ACTIVE, so the
  /// migration rewrites nothing. Archiving sets a timestamp; reactivating sets
  /// it back to NULL. Archive is NOT publication state - an archived entity
  /// keeps its detail URL at HTTP 200 with noindex, and leaves active listings
  /// and the sitemap.
  archivedAt  DateTime?

  @@index([archivedAt])
}

/// Rodeo athlete/contestant editorial identity (Batch 12). Distinct from editorial
/// byline `Author` and auth `User`. Only verified, published facts — no fabricated
/// bios, achievements, rankings or prize money. Rich evergreen body stored as `guide`
/// JSON (mirrors `Discipline.guide`). Participation is edition-level only.
model Competitor {
  id           String                    @id @default(uuid())
  slug         String                    @unique
  fullName     String
  knownAs      String?
  summary      String?
  guide        Json?
  hometownCity String?
  state        String?
  country      String?
  birthYear    Int?
  status       String?
  heroImage    String?
  imageCredit  String?
  sortOrder    Int                       @default(0)
  disciplines  CompetitorDiscipline[]
  editions     CompetitorParticipation[]
  articles     ArticleCompetitor[]
  media        CompetitorMedia[]
  results      CompetitionResult[]
  standings    CompetitionStanding[]
}

/// Competitor ↔ discipline (which events a competitor contests). Composite PK.
model CompetitorDiscipline {
  competitorId String
  disciplineId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@id([competitorId, disciplineId])
  @@index([disciplineId])
}

/// Competitor ↔ specific edition participation (Master Reqs: authoritative at the
/// edition grain, never the recurring event). `result`/`placement` are optional and
/// only ever set from verified facts — defaults are empty, not invented.
model CompetitorParticipation {
  competitorId String
  editionId    String
  result       String?
  placement    Int?
  note         String?
  sortOrder    Int               @default(0)
  competitor   Competitor        @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  edition      RodeoEventEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@id([competitorId, editionId])
  @@index([editionId])
}

/// Article ↔ competitor (mirrors ArticleDiscipline/ArticleEvent). Composite PK.
model ArticleCompetitor {
  articleId    String
  competitorId String
  article      Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@id([articleId, competitorId])
  @@index([competitorId])
}

/// Competitor media usage (mirrors VenueMedia/DisciplineMedia). Composite PK.
model CompetitorMedia {
  competitorId String
  mediaId      String
  role         String     @default("gallery")
  sortOrder    Int        @default(0)
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  media        MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([competitorId, mediaId])
  @@index([mediaId])
}

model EventDiscipline {
  disciplineId String
  eventId      String
  eventSlugRef String
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@id([disciplineId, eventId])
}

model ArticleDiscipline {
  articleId    String
  disciplineId String
  article      Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@id([articleId, disciplineId])
}

model ArticleHub {
  articleId String
  hubId     String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  hub       RodeoHub @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@id([articleId, hubId])
}

model ArticleEvent {
  articleId String
  eventId   String
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  event     RodeoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([articleId, eventId])
}

model ArticleEdition {
  articleId String
  editionId String
  article   Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  edition   RodeoEventEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@id([articleId, editionId])
}

/// Normalized redirect registry. One active redirect per source path.
model ArticleRedirect {
  id         String         @id @default(uuid())
  sourcePath String         @unique
  targetPath String
  statusCode Int            @default(308)
  status     RedirectStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
}

/// Durable record that a seeded foundational entity was deliberately deleted.
///
/// Without this, a deletion is only as permanent as the next `prisma db seed`:
/// the seed recreated the seven foundational disciplines whenever it could not
/// tell "deleted on purpose" from "never installed".
///
/// `key` holds the SEED's stable identity - the fixed primary key, e.g.
/// `disc-bull-riding` - not the slug. Slugs are editable, ids are not, so a
/// renamed discipline is still recognised and an old slug can never resurrect it.
model SeedTombstone {
  id        String   @id @default(uuid())
  /// Entity family, e.g. "discipline".
  kind      String
  /// The seeded record's stable primary key.
  key       String
  deletedAt DateTime @default(now())

  @@unique([kind, key])
}

model SeoRule {
  id          String         @id @default(uuid())
  code        String         @unique
  group       String
  severity    SeoSeverity
  enabled     Boolean        @default(true)
  description String?
  appliesTo   String?
  category    String         @default("technical")
  config      Json?
  defaultKind SeoFindingKind @default(DEFECT)
  ruleVersion String         @default("1")
  title       String?
  findings    SeoFinding[]
}

model SeoAuditRun {
  id            String       @id @default(uuid())
  scope         String
  engineVersion String
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  status        String       @default("completed")
  summary       Json?
  totalFindings Int          @default(0)
  triggeredById String?
  findings      SeoFinding[]

  @@index([startedAt])
}

model SeoFinding {
  id             String           @id @default(uuid())
  ruleId         String
  auditRunId     String?
  articleId      String?
  fingerprint    String           @unique
  severity       SeoSeverity
  status         SeoFindingStatus @default(OPEN)
  evidence       String?
  firstSeenAt    DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())
  affectedUrl    String?
  assignedToId   String?
  category       String           @default("technical")
  detail         Json?
  entityId       String?
  entityType     String           @default("article")
  kind           SeoFindingKind   @default(DEFECT)
  recommendation String?
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  ruleCode       String           @default("")
  ruleVersion    String           @default("1")
  article        Article?         @relation(fields: [articleId], references: [id])
  auditRun       SeoAuditRun?     @relation(fields: [auditRunId], references: [id])
  rule           SeoRule          @relation(fields: [ruleId], references: [id])

  @@index([status])
  @@index([severity])
  @@index([entityType, entityId])
  @@index([category])
}

model SeoConfig {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt
}

model User {
  id              String                     @id @default(uuid())
  email           String                     @unique
  name            String
  status          UserAccountStatus          @default(INVITED)
  createdAt       DateTime                   @default(now())
  lastLoginAt     DateTime?
  passwordHash    String?
  // Reader identity (Batch 24). `emailVerifiedAt` records verification status; it is
  // NOT required for login (no email provider configured — see docs). Staff vs reader
  // is determined by assigned roles/permissions, never by these columns.
  emailVerifiedAt DateTime?
  createdArticles Article[]                  @relation("ArticleCreatedBy")
  revisions       ArticleRevision[]
  auditLogs       AuditLog[]
  workflowEvents  EditorialWorkflowHistory[]
  uploadedMedia   MediaAsset[]               @relation("MediaUploader")
  passwordResets  PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  comments        ArticleComment[]           @relation("CommentAuthor")
  moderatedComments ArticleComment[]         @relation("CommentModerator")
  sessions        Session[]
  roles           UserRole[]
}

/// Email verification token (Batch 24). Mirrors PasswordResetToken: only the SHA-256
/// hash is stored, single-use, time-limited. Verification is gated behind a configured
/// email provider (none yet) — accounts remain usable; `emailVerifiedAt` tracks state.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Reader comment on a published article (Batch 24). Flat (no threads). Body is plain
/// text, rendered escaped (no raw HTML). Defaults to PENDING; only APPROVED is public.
model ArticleComment {
  id               String        @id @default(uuid())
  articleId        String
  authorId         String
  body             String
  status           CommentStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  moderatedById    String?
  moderatedAt      DateTime?
  moderationReason String?
  article          Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author           User          @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  moderatedBy      User?         @relation("CommentModerator", fields: [moderatedById], references: [id])

  @@index([articleId, status])
  @@index([authorId])
  @@index([status])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

/// Server-side session (opaque token stored as a SHA-256 hash; validated and
/// revocable server-side — Batch 03 §3).
model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique
  label String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, createdAt])
}

/// Site navigation (Batch 04 §F). `location` groups menus (header / footer-*).
/// `isSystem` protects canonical primary-section links from deletion; the five
/// section routes and seven discipline routes are never renamed/removed here.
model NavigationItem {
  id          String   @id @default(uuid())
  location    String
  label       String
  url         String
  description String?
  sortOrder   Int      @default(0)
  isExternal  Boolean  @default(false)
  isSystem    Boolean  @default(false)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([location, sortOrder])
}

/// One internal-search submission. `normalizedQuery` is already redacted/minimized
/// (lowercased, whitespace-collapsed, length-bounded, email/number-redacted).
model SearchQueryEvent {
  id              String   @id @default(uuid())
  normalizedQuery String
  queryLength     Int      @default(0)
  resultCount     Int      @default(0)
  zeroResult      Boolean  @default(false)
  contentType     String?
  source          String   @default("web")
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([normalizedQuery])
  @@index([zeroResult, createdAt])
}

/// A click on a search result (query → chosen destination). Used for CTR and to
/// distinguish satisfied vs. weak-engagement queries.
model SearchResultClickEvent {
  id              String              @id @default(uuid())
  normalizedQuery String
  entityType      AnalyticsEntityType
  entityId        String
  position        Int                 @default(0)
  createdAt       DateTime            @default(now())

  @@index([createdAt])
  @@index([normalizedQuery])
  @@index([entityType, entityId])
}

/// A first-party observed public content view. Labeled as an observed event, NOT a
/// verified unique human visitor (§7). Validated against a real published entity.
model ContentViewEvent {
  id         String              @id @default(uuid())
  entityType AnalyticsEntityType
  entityId   String
  path       String
  source     String              @default("web")
  createdAt  DateTime            @default(now())

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
}

/// Durable per-day rollup for dashboard performance and retention. Raw events can
/// be pruned past the retention window while aggregates are preserved. Empty-string
/// entityType/entityId keep the unique key usable for site-wide metrics.
model AnalyticsDailyAggregate {
  id         String   @id @default(uuid())
  day        DateTime @db.Date
  metric     String
  entityType String   @default("")
  entityId   String   @default("")
  count      Int      @default(0)
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([day, metric, entityType, entityId])
  @@index([metric, day])
}

/// External analytics provider connection. Credentials are NEVER stored here
/// (§9/§13); `propertyRef` is a non-secret label (e.g. GA4 property id, GSC site).
model AnalyticsProviderConnection {
  id             String                   @id @default(uuid())
  provider       AnalyticsProvider        @unique
  displayName    String
  status         ProviderConnectionStatus @default(NOT_CONNECTED)
  propertyRef    String?
  configuredById String?
  lastSyncAt     DateTime?
  lastError      String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @default(now()) @updatedAt
  syncRuns       AnalyticsSyncRun[]
}

/// A provider ingestion attempt (foundation; no runs execute until connected).
model AnalyticsSyncRun {
  id            String                      @id @default(uuid())
  connectionId  String
  provider      AnalyticsProvider
  status        String                      @default("not_connected")
  startedAt     DateTime                    @default(now())
  completedAt   DateTime?
  rowsIngested  Int                         @default(0)
  errorCategory String?
  connection    AnalyticsProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([provider, startedAt])
}

/// Analytics configuration (key → JSON): collection-enabled flag, retention days,
/// redaction options, display time zone. Mirrors the SeoConfig pattern.
model AnalyticsConfig {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt
}

/// A commercial partner. `verificationStatus` + evidence gate any "official" claim;
/// `isActive` gates public rendering. Never pre-populated with invented partners.
model AffiliatePartner {
  id                 String                         @id @default(uuid())
  name               String
  slug               String                         @unique
  website            String?
  category           AffiliateCategory              @default(OTHER)
  programType        String?
  isActive           Boolean                        @default(false)
  verificationStatus PartnerVerificationStatus      @default(UNVERIFIED)
  verifiedAt         DateTime?
  lastVerifiedAt     DateTime?
  complianceNotes    String?
  createdById        String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @default(now()) @updatedAt
  links              AffiliateLink[]
  programs           AffiliateProgram[]
  associations       CommercialEntityAssociation[]
  disclosures        MonetizationDisclosure[]
  sponsorships       SponsoredContentRelationship[]

  @@index([isActive, verificationStatus])
  @@index([category])
}

/// Optional grouping of links under a named partner program.
model AffiliateProgram {
  id          String                @id @default(uuid())
  partnerId   String
  name        String
  programType String?
  category    AffiliateCategory     @default(OTHER)
  defaultRel  AffiliateRelAttribute @default(SPONSORED_NOFOLLOW)
  status      MonetizationStatus    @default(DRAFT)
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @default(now()) @updatedAt
  links       AffiliateLink[]
  partner     AffiliatePartner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

/// Centralized affiliate link registry. `merchantUrl` is the original destination;
/// `trackingUrl` the affiliate destination (resolved by the /go redirect). URLs are
/// validated server-side (no javascript:/data:/private-network targets).
model AffiliateLink {
  id                String                    @id @default(uuid())
  partnerId         String
  programId         String?
  label             String
  merchantUrl       String
  trackingUrl       String?
  category          AffiliateCategory         @default(OTHER)
  rel               AffiliateRelAttribute     @default(SPONSORED_NOFOLLOW)
  status            MonetizationStatus        @default(DRAFT)
  isActive          Boolean                   @default(false)
  editorialContext  String?
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  lastVerifiedAt    DateTime?
  verificationNotes String?
  createdById       String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @default(now()) @updatedAt
  clicks            AffiliateClickAggregate[]
  partner           AffiliatePartner          @relation(fields: [partnerId], references: [id])
  program           AffiliateProgram?         @relation(fields: [programId], references: [id])
  placements        AffiliatePlacement[]

  @@index([partnerId])
  @@index([isActive, status])
  @@index([category])
}

/// Assignment of a link to a content entity (article/rodeo). Created/proposed via
/// article-edit rights; activation gated by monetization permissions.
model AffiliatePlacement {
  id           String               @id @default(uuid())
  linkId       String
  entityType   CommercialEntityType @default(ARTICLE)
  entityId     String
  articleId    String?
  position     String?
  status       MonetizationStatus   @default(DRAFT)
  isActive     Boolean              @default(false)
  note         String?
  proposedById String?
  approvedById String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt
  article      Article?             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  link         AffiliateLink        @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([articleId])
  @@index([linkId])
}

/// AdSense-ready logical placement. `enabled` + MonetizationConfiguration.adsenseEnabled
/// both gate public display; defaults keep external serving OFF.
model AdPlacement {
  id              String          @id @default(uuid())
  slot            AdPlacementSlot
  name            String
  pageScope       String          @default("global")
  enabled         Boolean         @default(false)
  device          String          @default("all")
  position        Int             @default(0)
  priority        Int             @default(0)
  responsive      Boolean         @default(true)
  adUnitConfig    Json?
  complianceNotes String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  @@index([pageScope, enabled])
  @@index([slot])
}

/// Reusable disclosure policy text (§15). `partnerId` optional for partner-specific
/// disclosure. Rendered close to the relevant commercial content, not only in footer.
model MonetizationDisclosure {
  id                String            @id @default(uuid())
  key               String            @unique
  scope             String
  label             String
  body              String
  requiredProminent Boolean           @default(true)
  enabled           Boolean           @default(true)
  partnerId         String?
  updatedById       String?
  updatedAt         DateTime          @default(now()) @updatedAt
  partner           AffiliatePartner? @relation(fields: [partnerId], references: [id])

  @@index([scope])
}

/// Sponsored-content classification, separate from ordinary affiliate links (§16).
model SponsoredContentRelationship {
  id              String                @id @default(uuid())
  articleId       String
  partnerId       String?
  sponsorName     String
  disclosureLabel String                @default("Sponsored")
  rel             AffiliateRelAttribute @default(SPONSORED)
  startAt         DateTime?
  endAt           DateTime?
  reviewNotes     String?
  status          MonetizationStatus    @default(DRAFT)
  isActive        Boolean               @default(false)
  createdById     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @default(now()) @updatedAt
  article         Article               @relation(fields: [articleId], references: [id], onDelete: Cascade)
  partner         AffiliatePartner?     @relation(fields: [partnerId], references: [id])

  @@index([articleId])
  @@index([partnerId])
}

/// A commercial relationship between a partner and a rodeo/editorial entity (§12).
/// Keeps event-vs-edition separation via entityType; never auto-copied across years.
model CommercialEntityAssociation {
  id               String               @id @default(uuid())
  partnerId        String
  entityType       CommercialEntityType
  entityId         String
  relationshipType String
  note             String?
  status           MonetizationStatus   @default(DRAFT)
  isActive         Boolean              @default(false)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  createdById      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  partner          AffiliatePartner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([partnerId])
}

/// Monetization configuration (key → JSON): adsenseEnabled, clickTrackingEnabled,
/// publisherId, global disclosure toggles. External serving/tracking OFF by default.
model MonetizationConfiguration {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt
}

/// Durable per-day outbound-click rollup (§18). Only written when click tracking is
/// owner-enabled; no identifiers stored. Mirrors the analytics aggregate pattern.
model AffiliateClickAggregate {
  id        String        @id @default(uuid())
  linkId    String
  day       DateTime      @db.Date
  count     Int           @default(0)
  updatedAt DateTime      @default(now()) @updatedAt
  link      AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, day])
  @@index([day])
}

/// Single-use, time-limited staff invitation. The raw token is shown once to the
/// inviting admin to share manually (no email is sent); only its SHA-256 hash is
/// stored. Accepting it sets the staff password and activates the account.
model StaffInvitation {
  id             String    @id @default(uuid())
  email          String
  roleKey        String
  tokenHash      String    @unique
  status         String    @default("PENDING")
  invitedById    String?
  acceptedUserId String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
  @@index([status, expiresAt])
}

/// Single-use, short-lived password reset token (hashed). Administrator-assisted
/// foundation — raw token is shown once for manual delivery; no email is sent.
model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Typed site-wide configuration (key → validated JSON). Domain-specific settings stay
/// owned by their modules (SEO/Analytics/Monetization); this holds only site identity,
/// editorial/rodeo display defaults and non-secret operational preferences (§16).
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt
}

/// Editor-controlled SEO overrides + editorial intro for a landing entity. All fields
/// optional; absent values fall back to the page's derived metadata. `noindex` is
/// additive-only (combined with content-based noindex, never overriding it).
model EntitySeo {
  id                String            @id @default(uuid())
  entityType        LandingEntityType
  entityId          String
  seoTitle          String?
  metaDescription   String?
  canonicalOverride String?
  ogImage           String?
  noindex           Boolean           @default(false)
  intro             String?
  updatedById       String?
  updatedAt         DateTime          @default(now()) @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
}

/// Entity-specific FAQ. Only `enabled` FAQs render publicly, ordered by `sortOrder`.
/// Duplicate questions within one entity are blocked (DB unique + case-insensitive
/// service check); empty questions/answers are rejected in the service.
model EntityFaq {
  id          String            @id @default(uuid())
  entityType  LandingEntityType
  entityId    String
  question    String
  answer      String
  sortOrder   Int               @default(0)
  enabled     Boolean           @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  @@unique([entityType, entityId, question])
  @@index([entityType, entityId, sortOrder])
}

/// Batch 14 — edition-scoped competition coverage. Generic + reusable across any rodeo
/// event/edition (NOT NFR-specific). Every record belongs to an annual edition; public
/// visibility requires coverageStatus=PUBLISHED AND verification=VERIFIED (service-gated).
/// Authoritative numerics use `Decimal` (Postgres numeric), never floating point. No
/// fabricated schedules/scores/standings — unknown times/scores stay null.
model CompetitionSession {
  id             String                   @id @default(uuid())
  editionId      String
  disciplineId   String?
  venueId        String?
  date           DateTime?
  title          String
  sessionType    String
  roundNumber    Int?
  startAt        DateTime?
  endAt          DateTime?
  timezone       String?
  sortOrder      Int                      @default(0)
  status         CompetitionSessionStatus @default(SCHEDULED)
  coverageStatus CoverageStatus           @default(DRAFT)
  verification   CoverageVerification     @default(UNVERIFIED)
  sourceRef      String?
  sourceUrl      String?
  verifiedById   String?
  verifiedAt     DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  version        Int                      @default(1)
  edition        RodeoEventEdition        @relation(fields: [editionId], references: [id], onDelete: Cascade)
  discipline     Discipline?              @relation(fields: [disciplineId], references: [id])
  venue          Venue?                   @relation(fields: [venueId], references: [id])
  results        CompetitionResult[]

  @@index([editionId, sortOrder])
  @@index([editionId, disciplineId])
}

model CompetitionResult {
  id             String                @id @default(uuid())
  editionId      String
  disciplineId   String
  sessionId      String?
  competitorId   String
  resultType     CompetitionResultType
  scoreNumeric   Decimal?              @db.Decimal(10, 3)
  timeSeconds    Decimal?              @db.Decimal(10, 3)
  placement      Int?
  isTie          Boolean               @default(false)
  coverageStatus CoverageStatus        @default(DRAFT)
  verification   CoverageVerification  @default(UNVERIFIED)
  sourceRef      String?
  sourceUrl      String?
  publishedAt    DateTime?
  verifiedById   String?
  verifiedAt     DateTime?
  notes          String?
  correctionOfId String?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  version        Int                   @default(1)
  edition        RodeoEventEdition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  discipline     Discipline            @relation(fields: [disciplineId], references: [id])
  session        CompetitionSession?   @relation(fields: [sessionId], references: [id])
  competitor     Competitor            @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  correctionOf   CompetitionResult?    @relation("ResultCorrection", fields: [correctionOfId], references: [id])
  corrections    CompetitionResult[]   @relation("ResultCorrection")

  @@index([editionId, disciplineId])
  @@index([competitorId])
  @@index([sessionId])
}

model CompetitionStanding {
  id             String               @id @default(uuid())
  editionId      String
  disciplineId   String?
  competitorId   String
  category       StandingCategory
  rankPosition   Int?
  aggregateValue Decimal?             @db.Decimal(12, 3)
  earnings       Decimal?             @db.Decimal(14, 2)
  points         Decimal?             @db.Decimal(12, 3)
  coverageStatus CoverageStatus       @default(DRAFT)
  verification   CoverageVerification @default(UNVERIFIED)
  sourceRef      String?
  sourceUrl      String?
  verifiedById   String?
  verifiedAt     DateTime?
  lastUpdatedAt  DateTime             @default(now())
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  version        Int                  @default(1)
  edition        RodeoEventEdition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  discipline     Discipline?          @relation(fields: [disciplineId], references: [id])
  competitor     Competitor           @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([editionId, category, disciplineId])
  @@index([competitorId])
}

/// Durable, multi-instance fixed-window rate limiter (Batch 17 §C). One row per
/// bucket key (e.g. "login:<ip>:<email>" / "media-upload:<userId>"); an atomic
/// upsert increments `count` within the active window and rolls it over when
/// `resetAt` has passed. Shared across app instances via Postgres, so it is not
/// defeated by horizontal scaling the way a per-process memory limiter is.
model RateLimitHit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

