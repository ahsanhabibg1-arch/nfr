generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Editorial byline identity (distinct from auth User — Master Reqs §7.1 authors).
model Author {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  role          String
  avatar        String?
  bio           String?
  credentials   String?
  editorialBeat String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  articles      Article[]
}

/// One of the five approved primary sections (and future sub-sections).
model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String    @unique
  description String?
  sortOrder   Int       @default(0)
  articles    Article[]
}

model Tag {
  id       String       @id @default(uuid())
  slug     String       @unique
  name     String
  articles ArticleTag[]
}

model Article {
  id                  String                         @id @default(uuid())
  slug                String                         @unique
  title               String
  deck                String?
  excerpt             String
  imageSeoTitle       String?
  imageAltText        String?
  subcategory         String?
  articleType         String
  workflowStatus      WorkflowStatus                 @default(DRAFT)
  readTime            String?
  wordCount           Int?
  isLeadHero          Boolean                        @default(false)
  isFeatured          Boolean                        @default(false)
  heroImageUrl        String?
  imageCredit         String?
  imageCaption        String?
  imageRightsStatus   ImageRightsStatus              @default(UNRESOLVED)
  disclosureType      String                         @default("editorial-independent")
  disclosureNote      String?
  takeaways           String[]                       @default([])
  publishedAt         DateTime?
  scheduledAt         DateTime?
  reviewedAt          DateTime?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  authorId            String
  categoryId          String
  createdById         String?
  version             Int                            @default(1)
  searchVector        Unsupported("tsvector")?       @default(dbgenerated("((((setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(deck, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(excerpt, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(subcategory, ''::text)), 'C'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(\"articleType\", ''::text)), 'C'::\"char\"))"))
  affiliatePlacements AffiliatePlacement[]
  competitors         ArticleCompetitor[]
  author              Author                         @relation(fields: [authorId], references: [id])
  category            Category                       @relation(fields: [categoryId], references: [id])
  createdBy           User?                          @relation("ArticleCreatedBy", fields: [createdById], references: [id])
  blocks              ArticleBlock[]
  disciplines         ArticleDiscipline[]
  editions            ArticleEdition[]
  events              ArticleEvent[]
  hubs                ArticleHub[]
  media               ArticleMedia[]
  relatedTo           ArticleRelation[]              @relation("ArticleRelationSource")
  relatedFrom         ArticleRelation[]              @relation("ArticleRelationTarget")
  revisions           ArticleRevision[]
  seo                 ArticleSeo?
  sources             ArticleSource[]
  tags                ArticleTag[]
  workflow            EditorialWorkflowHistory[]
  seoFindings         SeoFinding[]
  sponsorships        SponsoredContentRelationship[]

  @@index([workflowStatus])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([workflowStatus, publishedAt])
  @@index([searchVector], type: Gin)
}

/// Curated article-to-article relationships (replaces relatedArticleIds JSON).
model ArticleRelation {
  sourceId String
  targetId String
  source   Article @relation("ArticleRelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target   Article @relation("ArticleRelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId])
}

/// Structured article body. JSON `data` is justified: block shapes are a flexible
/// discriminated union; blockType + sortOrder stay queryable columns.
model ArticleBlock {
  id        String  @id @default(uuid())
  articleId String
  sortOrder Int
  blockType String
  data      Json
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, sortOrder])
  @@index([articleId])
}

/// Per-article SEO payload (Master Reqs §5 / Batch 02 §4 ArticleSEO).
model ArticleSeo {
  id                 String  @id @default(uuid())
  articleId          String  @unique
  seoTitle           String?
  metaDescription    String?
  canonicalUrl       String?
  ogImage            String?
  robots             String  @default("index, follow")
  structuredDataType String  @default("Article")
  article            Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ArticleRevision {
  id         String         @id @default(uuid())
  articleId  String
  revisionNo Int
  actorName  String
  actorRole  String
  status     WorkflowStatus
  summary    String
  snapshot   Json
  createdAt  DateTime       @default(now())
  actorId    String?
  actor      User?          @relation(fields: [actorId], references: [id])
  article    Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, revisionNo])
  @@index([articleId, createdAt])
}

/// Workflow state transition log (distinct from content revisions).
model EditorialWorkflowHistory {
  id         String          @id @default(uuid())
  articleId  String
  fromStatus WorkflowStatus?
  toStatus   WorkflowStatus
  actorName  String
  note       String?
  createdAt  DateTime        @default(now())
  actorId    String?
  actor      User?           @relation(fields: [actorId], references: [id])
  article    Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

/// Reusable source directory.
model Source {
  id               String               @id @default(uuid())
  title            String
  url              String
  publisher        String?
  type             String?
  classification   SourceClassification @default(INDEPENDENT_REFERENCE)
  status           SourceStatus         @default(NEEDS_REVIEW)
  verificationDate DateTime?
  articles         ArticleSource[]

  @@index([status])
}

model ArticleSource {
  articleId String
  sourceId  String
  note      String?
  sortOrder Int     @default(0)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source    Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([articleId, sourceId])
}

/// Digital asset (Batch 05). Binaries live in object storage (`storageProvider` +
/// `storageKey`); Postgres holds only metadata/relationships/lifecycle. Legacy
/// seeded rows use provider `legacy-local` and keep their `/assets/...` url.
model MediaAsset {
  id                  String                   @id @default(uuid())
  storageKey          String                   @unique
  url                 String
  filename            String
  mimeType            String?
  dimensions          String?
  bytes               Int?
  format              String?
  seoTitle            String?
  altText             String?
  credit              String?
  rightsStatus        ImageRightsStatus        @default(UNRESOLVED)
  uploadedAt          DateTime                 @default(now())
  caption             String?
  checksum            String?
  copyrightHolder     String?
  derivatives         Json?
  extension           String?
  height              Int?
  licenseSourceUrl    String?
  licenseType         MediaLicenseType         @default(UNCONFIRMED)
  processingStatus    MediaProcessingStatus    @default(READY)
  rightsConfirmed     Boolean                  @default(false)
  rightsConfirmedAt   DateTime?
  rightsConfirmedById String?
  safeFilename        String?
  sourceAttribution   String?
  storageProvider     String                   @default("legacy-local")
  title               String?
  updatedAt           DateTime                 @default(now()) @updatedAt
  uploadedById        String?
  usageRestrictions   String?
  visibility          MediaVisibility          @default(PUBLIC)
  width               Int?
  articles            ArticleMedia[]
  disciplines         DisciplineMedia[]
  competitors         CompetitorMedia[]
  uploadedBy          User?                    @relation("MediaUploader", fields: [uploadedById], references: [id])
  editions            RodeoEventEditionMedia[]
  events              RodeoEventMedia[]
  hubs                RodeoHubMedia[]
  venues              VenueMedia[]

  @@index([visibility, processingStatus])
  @@index([uploadedById])
  @@index([checksum])
}

model RodeoHubMedia {
  hubId     String
  mediaId   String
  role      String     @default("gallery")
  sortOrder Int        @default(0)
  hub       RodeoHub   @relation(fields: [hubId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([hubId, mediaId])
  @@index([mediaId])
}

model RodeoEventMedia {
  eventId   String
  mediaId   String
  role      String     @default("gallery")
  sortOrder Int        @default(0)
  event     RodeoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([eventId, mediaId])
  @@index([mediaId])
}

model RodeoEventEditionMedia {
  editionId String
  mediaId   String
  role      String            @default("gallery")
  sortOrder Int               @default(0)
  edition   RodeoEventEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  media     MediaAsset        @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([editionId, mediaId])
  @@index([mediaId])
}

model DisciplineMedia {
  disciplineId String
  mediaId      String
  role         String     @default("gallery")
  sortOrder    Int        @default(0)
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  media        MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([disciplineId, mediaId])
  @@index([mediaId])
}

model VenueMedia {
  venueId   String
  mediaId   String
  role      String     @default("gallery")
  sortOrder Int        @default(0)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([venueId, mediaId])
  @@index([mediaId])
}

model ArticleMedia {
  articleId String
  mediaId   String
  usageKey  String
  altText   String?
  caption   String?
  sortOrder Int        @default(0)
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([articleId, usageKey])
  @@index([mediaId])
}

/// The seven NFR disciplines. Rich evergreen guide body stored as JSON (`guide`)
/// — a flexible nested structure that does not benefit from further tables yet.
model Discipline {
  id          String                 @id @default(uuid())
  slug        String                 @unique
  name        String
  shortName   String?
  category    String?
  tagline     String?
  summary     String
  image       String?
  imageCredit String?
  guide       Json?
  sortOrder   Int                    @default(0)
  articles    ArticleDiscipline[]
  media       DisciplineMedia[]
  events      EventDiscipline[]
  competitors CompetitorDiscipline[]
  compSessions CompetitionSession[]
  compResults  CompetitionResult[]
  compStandings CompetitionStanding[]
}

model RodeoHub {
  id                String          @id @default(uuid())
  slug              String          @unique
  title             String
  region            String?
  circuitType       String?
  description       String?
  annualEventsCount Int             @default(0)
  sortOrder         Int             @default(0)
  articles          ArticleHub[]
  hubEvents         RodeoHubEvent[]
  media             RodeoHubMedia[]
}

/// Stable recurring event identity, independent of any hub (Master Reqs §2.1).
model RodeoEvent {
  id               String              @id @default(uuid())
  slug             String              @unique
  name             String
  location         String?
  traditionalMonth String?
  status           String?
  description      String?
  organizerName    String?
  officialUrl      String?
  isFlagship       Boolean             @default(false)
  articles         ArticleEvent[]
  editions         RodeoEventEdition[]
  media            RodeoEventMedia[]
  hubLinks         RodeoHubEvent[]
}

/// Curated hub ↔ recurring-event association (Batch 10). A hub lists its associated
/// events without owning them — the event URL is hub-independent (Master Reqs:
/// "hub association does not change event URL"). Additive M:N join.
model RodeoHubEvent {
  hubId     String
  eventId   String
  sortOrder Int        @default(0)
  event     RodeoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hub       RodeoHub   @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@id([hubId, eventId])
  @@index([eventId])
}

/// Specific occurrence/year. Unique per (eventId, editionSlug) — Master Reqs §7.2.
model RodeoEventEdition {
  id             String                    @id @default(uuid())
  eventId        String
  editionSlug    String
  label          String
  year           Int?
  startAt        DateTime?
  endAt          DateTime?
  timezone       String?
  purseBenchmark String?
  venueId        String?
  articles       ArticleEdition[]
  event          RodeoEvent                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue          Venue?                    @relation(fields: [venueId], references: [id])
  media          RodeoEventEditionMedia[]
  competitors    CompetitorParticipation[]
  sessions       CompetitionSession[]
  results        CompetitionResult[]
  standings      CompetitionStanding[]

  @@unique([eventId, editionSlug])
}

model Venue {
  id          String              @id @default(uuid())
  slug        String              @unique
  name        String
  nickname    String?
  summary     String?
  description String?
  websiteUrl  String?
  capacity    Int?
  openedYear  Int?
  latitude    Float?
  longitude   Float?
  city        String?
  state       String?
  country     String?
  sortOrder   Int                 @default(0)
  editions    RodeoEventEdition[]
  media       VenueMedia[]
  compSessions CompetitionSession[]
}

/// Rodeo athlete/contestant editorial identity (Batch 12). Distinct from editorial
/// byline `Author` and auth `User`. Only verified, published facts — no fabricated
/// bios, achievements, rankings or prize money. Rich evergreen body stored as `guide`
/// JSON (mirrors `Discipline.guide`). Participation is edition-level only.
model Competitor {
  id           String                    @id @default(uuid())
  slug         String                    @unique
  fullName     String
  knownAs      String?
  summary      String?
  guide        Json?
  hometownCity String?
  state        String?
  country      String?
  birthYear    Int?
  status       String?
  heroImage    String?
  imageCredit  String?
  sortOrder    Int                       @default(0)
  disciplines  CompetitorDiscipline[]
  editions     CompetitorParticipation[]
  articles     ArticleCompetitor[]
  media        CompetitorMedia[]
  results      CompetitionResult[]
  standings    CompetitionStanding[]
}

/// Competitor ↔ discipline (which events a competitor contests). Composite PK.
model CompetitorDiscipline {
  competitorId String
  disciplineId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@id([competitorId, disciplineId])
  @@index([disciplineId])
}

/// Competitor ↔ specific edition participation (Master Reqs: authoritative at the
/// edition grain, never the recurring event). `result`/`placement` are optional and
/// only ever set from verified facts — defaults are empty, not invented.
model CompetitorParticipation {
  competitorId String
  editionId    String
  result       String?
  placement    Int?
  note         String?
  sortOrder    Int               @default(0)
  competitor   Competitor        @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  edition      RodeoEventEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@id([competitorId, editionId])
  @@index([editionId])
}

/// Article ↔ competitor (mirrors ArticleDiscipline/ArticleEvent). Composite PK.
model ArticleCompetitor {
  articleId    String
  competitorId String
  article      Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@id([articleId, competitorId])
  @@index([competitorId])
}

/// Competitor media usage (mirrors VenueMedia/DisciplineMedia). Composite PK.
model CompetitorMedia {
  competitorId String
  mediaId      String
  role         String     @default("gallery")
  sortOrder    Int        @default(0)
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  media        MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([competitorId, mediaId])
  @@index([mediaId])
}

model EventDiscipline {
  disciplineId String
  eventId      String
  eventSlugRef String
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@id([disciplineId, eventId])
}

model ArticleDiscipline {
  articleId    String
  disciplineId String
  article      Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@id([articleId, disciplineId])
}

model ArticleHub {
  articleId String
  hubId     String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  hub       RodeoHub @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@id([articleId, hubId])
}

model ArticleEvent {
  articleId String
  eventId   String
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  event     RodeoEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([articleId, eventId])
}

model ArticleEdition {
  articleId String
  editionId String
  article   Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  edition   RodeoEventEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@id([articleId, editionId])
}

/// Normalized redirect registry. One active redirect per source path.
model ArticleRedirect {
  id         String         @id @default(uuid())
  sourcePath String         @unique
  targetPath String
  statusCode Int            @default(308)
  status     RedirectStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())
}

model SeoRule {
  id          String         @id @default(uuid())
  code        String         @unique
  group       String
  severity    SeoSeverity
  enabled     Boolean        @default(true)
  description String?
  appliesTo   String?
  category    String         @default("technical")
  config      Json?
  defaultKind SeoFindingKind @default(DEFECT)
  ruleVersion String         @default("1")
  title       String?
  findings    SeoFinding[]
}

model SeoAuditRun {
  id            String       @id @default(uuid())
  scope         String
  engineVersion String
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  status        String       @default("completed")
  summary       Json?
  totalFindings Int          @default(0)
  triggeredById String?
  findings      SeoFinding[]

  @@index([startedAt])
}

model SeoFinding {
  id             String           @id @default(uuid())
  ruleId         String
  auditRunId     String?
  articleId      String?
  fingerprint    String           @unique
  severity       SeoSeverity
  status         SeoFindingStatus @default(OPEN)
  evidence       String?
  firstSeenAt    DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())
  affectedUrl    String?
  assignedToId   String?
  category       String           @default("technical")
  detail         Json?
  entityId       String?
  entityType     String           @default("article")
  kind           SeoFindingKind   @default(DEFECT)
  recommendation String?
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  ruleCode       String           @default("")
  ruleVersion    String           @default("1")
  article        Article?         @relation(fields: [articleId], references: [id])
  auditRun       SeoAuditRun?     @relation(fields: [auditRunId], references: [id])
  rule           SeoRule          @relation(fields: [ruleId], references: [id])

  @@index([status])
  @@index([severity])
  @@index([entityType, entityId])
  @@index([category])
}

model SeoConfig {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt
}

model User {
  id              String                     @id @default(uuid())
  email           String                     @unique
  name            String
  status          UserAccountStatus          @default(INVITED)
  createdAt       DateTime                   @default(now())
  lastLoginAt     DateTime?
  passwordHash    String?
  createdArticles Article[]                  @relation("ArticleCreatedBy")
  revisions       ArticleRevision[]
  auditLogs       AuditLog[]
  workflowEvents  EditorialWorkflowHistory[]
  uploadedMedia   MediaAsset[]               @relation("MediaUploader")
  passwordResets  PasswordResetToken[]
  sessions        Session[]
  roles           UserRole[]
}

/// Server-side session (opaque token stored as a SHA-256 hash; validated and
/// revocable server-side — Batch 03 §3).
model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique
  label String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, createdAt])
}

/// Site navigation (Batch 04 §F). `location` groups menus (header / footer-*).
/// `isSystem` protects canonical primary-section links from deletion; the five
/// section routes and seven discipline routes are never renamed/removed here.
model NavigationItem {
  id         String   @id @default(uuid())
  location   String
  label      String
  url        String
  sortOrder  Int      @default(0)
  isExternal Boolean  @default(false)
  isSystem   Boolean  @default(false)
  visible    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([location, sortOrder])
}

/// One internal-search submission. `normalizedQuery` is already redacted/minimized
/// (lowercased, whitespace-collapsed, length-bounded, email/number-redacted).
model SearchQueryEvent {
  id              String   @id @default(uuid())
  normalizedQuery String
  queryLength     Int      @default(0)
  resultCount     Int      @default(0)
  zeroResult      Boolean  @default(false)
  contentType     String?
  source          String   @default("web")
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([normalizedQuery])
  @@index([zeroResult, createdAt])
}

/// A click on a search result (query → chosen destination). Used for CTR and to
/// distinguish satisfied vs. weak-engagement queries.
model SearchResultClickEvent {
  id              String              @id @default(uuid())
  normalizedQuery String
  entityType      AnalyticsEntityType
  entityId        String
  position        Int                 @default(0)
  createdAt       DateTime            @default(now())

  @@index([createdAt])
  @@index([normalizedQuery])
  @@index([entityType, entityId])
}

/// A first-party observed public content view. Labeled as an observed event, NOT a
/// verified unique human visitor (§7). Validated against a real published entity.
model ContentViewEvent {
  id         String              @id @default(uuid())
  entityType AnalyticsEntityType
  entityId   String
  path       String
  source     String              @default("web")
  createdAt  DateTime            @default(now())

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
}

/// Durable per-day rollup for dashboard performance and retention. Raw events can
/// be pruned past the retention window while aggregates are preserved. Empty-string
/// entityType/entityId keep the unique key usable for site-wide metrics.
model AnalyticsDailyAggregate {
  id         String   @id @default(uuid())
  day        DateTime @db.Date
  metric     String
  entityType String   @default("")
  entityId   String   @default("")
  count      Int      @default(0)
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([day, metric, entityType, entityId])
  @@index([metric, day])
}

/// External analytics provider connection. Credentials are NEVER stored here
/// (§9/§13); `propertyRef` is a non-secret label (e.g. GA4 property id, GSC site).
model AnalyticsProviderConnection {
  id             String                   @id @default(uuid())
  provider       AnalyticsProvider        @unique
  displayName    String
  status         ProviderConnectionStatus @default(NOT_CONNECTED)
  propertyRef    String?
  configuredById String?
  lastSyncAt     DateTime?
  lastError      String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @default(now()) @updatedAt
  syncRuns       AnalyticsSyncRun[]
}

/// A provider ingestion attempt (foundation; no runs execute until connected).
model AnalyticsSyncRun {
  id            String                      @id @default(uuid())
  connectionId  String
  provider      AnalyticsProvider
  status        String                      @default("not_connected")
  startedAt     DateTime                    @default(now())
  completedAt   DateTime?
  rowsIngested  Int                         @default(0)
  errorCategory String?
  connection    AnalyticsProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([provider, startedAt])
}

/// Analytics configuration (key → JSON): collection-enabled flag, retention days,
/// redaction options, display time zone. Mirrors the SeoConfig pattern.
model AnalyticsConfig {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt
}

/// A commercial partner. `verificationStatus` + evidence gate any "official" claim;
/// `isActive` gates public rendering. Never pre-populated with invented partners.
model AffiliatePartner {
  id                 String                         @id @default(uuid())
  name               String
  slug               String                         @unique
  website            String?
  category           AffiliateCategory              @default(OTHER)
  programType        String?
  isActive           Boolean                        @default(false)
  verificationStatus PartnerVerificationStatus      @default(UNVERIFIED)
  verifiedAt         DateTime?
  lastVerifiedAt     DateTime?
  complianceNotes    String?
  createdById        String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @default(now()) @updatedAt
  links              AffiliateLink[]
  programs           AffiliateProgram[]
  associations       CommercialEntityAssociation[]
  disclosures        MonetizationDisclosure[]
  sponsorships       SponsoredContentRelationship[]

  @@index([isActive, verificationStatus])
  @@index([category])
}

/// Optional grouping of links under a named partner program.
model AffiliateProgram {
  id          String                @id @default(uuid())
  partnerId   String
  name        String
  programType String?
  category    AffiliateCategory     @default(OTHER)
  defaultRel  AffiliateRelAttribute @default(SPONSORED_NOFOLLOW)
  status      MonetizationStatus    @default(DRAFT)
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @default(now()) @updatedAt
  links       AffiliateLink[]
  partner     AffiliatePartner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

/// Centralized affiliate link registry. `merchantUrl` is the original destination;
/// `trackingUrl` the affiliate destination (resolved by the /go redirect). URLs are
/// validated server-side (no javascript:/data:/private-network targets).
model AffiliateLink {
  id                String                    @id @default(uuid())
  partnerId         String
  programId         String?
  label             String
  merchantUrl       String
  trackingUrl       String?
  category          AffiliateCategory         @default(OTHER)
  rel               AffiliateRelAttribute     @default(SPONSORED_NOFOLLOW)
  status            MonetizationStatus        @default(DRAFT)
  isActive          Boolean                   @default(false)
  editorialContext  String?
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  lastVerifiedAt    DateTime?
  verificationNotes String?
  createdById       String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @default(now()) @updatedAt
  clicks            AffiliateClickAggregate[]
  partner           AffiliatePartner          @relation(fields: [partnerId], references: [id])
  program           AffiliateProgram?         @relation(fields: [programId], references: [id])
  placements        AffiliatePlacement[]

  @@index([partnerId])
  @@index([isActive, status])
  @@index([category])
}

/// Assignment of a link to a content entity (article/rodeo). Created/proposed via
/// article-edit rights; activation gated by monetization permissions.
model AffiliatePlacement {
  id           String               @id @default(uuid())
  linkId       String
  entityType   CommercialEntityType @default(ARTICLE)
  entityId     String
  articleId    String?
  position     String?
  status       MonetizationStatus   @default(DRAFT)
  isActive     Boolean              @default(false)
  note         String?
  proposedById String?
  approvedById String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt
  article      Article?             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  link         AffiliateLink        @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([articleId])
  @@index([linkId])
}

/// AdSense-ready logical placement. `enabled` + MonetizationConfiguration.adsenseEnabled
/// both gate public display; defaults keep external serving OFF.
model AdPlacement {
  id              String          @id @default(uuid())
  slot            AdPlacementSlot
  name            String
  pageScope       String          @default("global")
  enabled         Boolean         @default(false)
  device          String          @default("all")
  position        Int             @default(0)
  priority        Int             @default(0)
  responsive      Boolean         @default(true)
  adUnitConfig    Json?
  complianceNotes String?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  @@index([pageScope, enabled])
  @@index([slot])
}

/// Reusable disclosure policy text (§15). `partnerId` optional for partner-specific
/// disclosure. Rendered close to the relevant commercial content, not only in footer.
model MonetizationDisclosure {
  id                String            @id @default(uuid())
  key               String            @unique
  scope             String
  label             String
  body              String
  requiredProminent Boolean           @default(true)
  enabled           Boolean           @default(true)
  partnerId         String?
  updatedById       String?
  updatedAt         DateTime          @default(now()) @updatedAt
  partner           AffiliatePartner? @relation(fields: [partnerId], references: [id])

  @@index([scope])
}

/// Sponsored-content classification, separate from ordinary affiliate links (§16).
model SponsoredContentRelationship {
  id              String                @id @default(uuid())
  articleId       String
  partnerId       String?
  sponsorName     String
  disclosureLabel String                @default("Sponsored")
  rel             AffiliateRelAttribute @default(SPONSORED)
  startAt         DateTime?
  endAt           DateTime?
  reviewNotes     String?
  status          MonetizationStatus    @default(DRAFT)
  isActive        Boolean               @default(false)
  createdById     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @default(now()) @updatedAt
  article         Article               @relation(fields: [articleId], references: [id], onDelete: Cascade)
  partner         AffiliatePartner?     @relation(fields: [partnerId], references: [id])

  @@index([articleId])
  @@index([partnerId])
}

/// A commercial relationship between a partner and a rodeo/editorial entity (§12).
/// Keeps event-vs-edition separation via entityType; never auto-copied across years.
model CommercialEntityAssociation {
  id               String               @id @default(uuid())
  partnerId        String
  entityType       CommercialEntityType
  entityId         String
  relationshipType String
  note             String?
  status           MonetizationStatus   @default(DRAFT)
  isActive         Boolean              @default(false)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  createdById      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  partner          AffiliatePartner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([partnerId])
}

/// Monetization configuration (key → JSON): adsenseEnabled, clickTrackingEnabled,
/// publisherId, global disclosure toggles. External serving/tracking OFF by default.
model MonetizationConfiguration {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt
}

/// Durable per-day outbound-click rollup (§18). Only written when click tracking is
/// owner-enabled; no identifiers stored. Mirrors the analytics aggregate pattern.
model AffiliateClickAggregate {
  id        String        @id @default(uuid())
  linkId    String
  day       DateTime      @db.Date
  count     Int           @default(0)
  updatedAt DateTime      @default(now()) @updatedAt
  link      AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, day])
  @@index([day])
}

/// Single-use, time-limited staff invitation. The raw token is shown once to the
/// inviting admin to share manually (no email is sent); only its SHA-256 hash is
/// stored. Accepting it sets the staff password and activates the account.
model StaffInvitation {
  id             String    @id @default(uuid())
  email          String
  roleKey        String
  tokenHash      String    @unique
  status         String    @default("PENDING")
  invitedById    String?
  acceptedUserId String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
  @@index([status, expiresAt])
}

/// Single-use, short-lived password reset token (hashed). Administrator-assisted
/// foundation — raw token is shown once for manual delivery; no email is sent.
model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Typed site-wide configuration (key → validated JSON). Domain-specific settings stay
/// owned by their modules (SEO/Analytics/Monetization); this holds only site identity,
/// editorial/rodeo display defaults and non-secret operational preferences (§16).
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt
}

/// Editor-controlled SEO overrides + editorial intro for a landing entity. All fields
/// optional; absent values fall back to the page's derived metadata. `noindex` is
/// additive-only (combined with content-based noindex, never overriding it).
model EntitySeo {
  id                String            @id @default(uuid())
  entityType        LandingEntityType
  entityId          String
  seoTitle          String?
  metaDescription   String?
  canonicalOverride String?
  ogImage           String?
  noindex           Boolean           @default(false)
  intro             String?
  updatedById       String?
  updatedAt         DateTime          @default(now()) @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
}

/// Entity-specific FAQ. Only `enabled` FAQs render publicly, ordered by `sortOrder`.
/// Duplicate questions within one entity are blocked (DB unique + case-insensitive
/// service check); empty questions/answers are rejected in the service.
model EntityFaq {
  id          String            @id @default(uuid())
  entityType  LandingEntityType
  entityId    String
  question    String
  answer      String
  sortOrder   Int               @default(0)
  enabled     Boolean           @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  @@unique([entityType, entityId, question])
  @@index([entityType, entityId, sortOrder])
}

/// Batch 14 — edition-scoped competition coverage. Generic + reusable across any rodeo
/// event/edition (NOT NFR-specific). Every record belongs to an annual edition; public
/// visibility requires coverageStatus=PUBLISHED AND verification=VERIFIED (service-gated).
/// Authoritative numerics use `Decimal` (Postgres numeric), never floating point. No
/// fabricated schedules/scores/standings — unknown times/scores stay null.
model CompetitionSession {
  id             String                   @id @default(uuid())
  editionId      String
  disciplineId   String?
  venueId        String?
  date           DateTime?
  title          String
  sessionType    String
  roundNumber    Int?
  startAt        DateTime?
  endAt          DateTime?
  timezone       String?
  sortOrder      Int                      @default(0)
  status         CompetitionSessionStatus @default(SCHEDULED)
  coverageStatus CoverageStatus           @default(DRAFT)
  verification   CoverageVerification     @default(UNVERIFIED)
  sourceRef      String?
  sourceUrl      String?
  verifiedById   String?
  verifiedAt     DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  edition        RodeoEventEdition        @relation(fields: [editionId], references: [id], onDelete: Cascade)
  discipline     Discipline?              @relation(fields: [disciplineId], references: [id])
  venue          Venue?                   @relation(fields: [venueId], references: [id])
  results        CompetitionResult[]

  @@index([editionId, sortOrder])
  @@index([editionId, disciplineId])
}

model CompetitionResult {
  id             String                @id @default(uuid())
  editionId      String
  disciplineId   String
  sessionId      String?
  competitorId   String
  resultType     CompetitionResultType
  scoreNumeric   Decimal?              @db.Decimal(10, 3)
  timeSeconds    Decimal?              @db.Decimal(10, 3)
  placement      Int?
  isTie          Boolean               @default(false)
  coverageStatus CoverageStatus        @default(DRAFT)
  verification   CoverageVerification  @default(UNVERIFIED)
  sourceRef      String?
  sourceUrl      String?
  publishedAt    DateTime?
  verifiedById   String?
  verifiedAt     DateTime?
  notes          String?
  correctionOfId String?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  edition        RodeoEventEdition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  discipline     Discipline            @relation(fields: [disciplineId], references: [id])
  session        CompetitionSession?   @relation(fields: [sessionId], references: [id])
  competitor     Competitor            @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  correctionOf   CompetitionResult?    @relation("ResultCorrection", fields: [correctionOfId], references: [id])
  corrections    CompetitionResult[]   @relation("ResultCorrection")

  @@index([editionId, disciplineId])
  @@index([competitorId])
  @@index([sessionId])
}

model CompetitionStanding {
  id             String               @id @default(uuid())
  editionId      String
  disciplineId   String?
  competitorId   String
  category       StandingCategory
  rankPosition   Int?
  aggregateValue Decimal?             @db.Decimal(12, 3)
  earnings       Decimal?             @db.Decimal(14, 2)
  points         Decimal?             @db.Decimal(12, 3)
  coverageStatus CoverageStatus       @default(DRAFT)
  verification   CoverageVerification @default(UNVERIFIED)
  sourceRef      String?
  sourceUrl      String?
  verifiedById   String?
  verifiedAt     DateTime?
  lastUpdatedAt  DateTime             @default(now())
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  edition        RodeoEventEdition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  discipline     Discipline?          @relation(fields: [disciplineId], references: [id])
  competitor     Competitor           @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([editionId, category, disciplineId])
  @@index([competitorId])
}

/// Editorial state for coverage records (parallels article workflow; no SCHEDULED).
enum CoverageStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

/// Source-verification state (distinct from editorial state).
enum CoverageVerification {
  UNVERIFIED
  VERIFIED
  CORRECTION_REQUIRED
}

enum CompetitionSessionStatus {
  SCHEDULED
  RESCHEDULED
  POSTPONED
  CANCELLED
  COMPLETED
}

enum CompetitionResultType {
  TIME
  SCORE
  NO_TIME
  NO_SCORE
  DISQUALIFIED
  WITHDRAWN
}

/// Standings categories must not be mixed (round vs aggregate vs championship vs season).
enum StandingCategory {
  ROUND
  AGGREGATE
  CHAMPIONSHIP
  SEASON
}

enum WorkflowStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ImageRightsStatus {
  STAFF_PHOTO
  EDITORIAL_POOL
  PRCA_ARCHIVE
  LICENSED_CREATIVE
  UNRESOLVED
}

enum MediaLicenseType {
  OWNED
  LICENSED
  PERMISSION_GRANTED
  PUBLIC_DOMAIN
  OTHER
  UNCONFIRMED
}

enum MediaProcessingStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum MediaVisibility {
  DRAFT
  PUBLIC
  ARCHIVED
}

enum SourceClassification {
  OFFICIAL
  INDEPENDENT_REFERENCE
  HISTORICAL_ARCHIVE
}

enum SourceStatus {
  VERIFIED
  NEEDS_REVIEW
  EXPIRED
}

enum SeoSeverity {
  CRITICAL
  WARNING
  NOTICE
  PASSED
  HIGH
  MEDIUM
  LOW
  INFO
}

enum SeoFindingKind {
  DEFECT
  RECOMMENDATION
  OPPORTUNITY
  NOT_PERFORMED
}

enum SeoFindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  IGNORED
  REOPENED
}

enum RedirectStatus {
  ACTIVE
  DISABLED
}

enum UserAccountStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// Entity kinds referenced by analytics events (content views, search clicks).
/// SECTION = a primary-section landing page; CATEGORY = a category archive.
enum AnalyticsEntityType {
  ARTICLE
  DISCIPLINE
  CATEGORY
  SECTION
  RODEO_HUB
  RODEO_EVENT
  RODEO_EDITION
}

/// Analytics data sources kept strictly distinct (§10/§14): first-party observed
/// events, internal search, and the two external Google providers.
enum AnalyticsProvider {
  FIRST_PARTY
  INTERNAL_SEARCH
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_ANALYTICS_4
}

/// External-provider connection lifecycle. NOT_CONNECTED until real, authorized
/// credentials are configured and verified (§13/§14). No credentials are stored
/// in the database — only a non-secret reference label and a status.
enum ProviderConnectionStatus {
  NOT_CONNECTED
  CONFIGURED
  CONNECTED
  SYNCING
  ERROR
  DISABLED
}

/// Commercial product category for partners/links (§6).
enum AffiliateCategory {
  STREAMING
  TICKETS
  TRAVEL
  APPAREL
  BOOTS
  ACCESSORIES
  EQUIPMENT
  OTHER
}

/// Partner verification lifecycle. A partner is never treated as official/authorized
/// without VERIFIED evidence (§6/§13/§14).
enum PartnerVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

/// Shared lifecycle for links / placements / sponsorships / associations.
enum MonetizationStatus {
  DRAFT
  ACTIVE
  INACTIVE
  EXPIRED
}

/// Paid-link attribute policy (§7/§16). Default is sponsored+nofollow+noopener.
enum AffiliateRelAttribute {
  SPONSORED
  NOFOLLOW
  SPONSORED_NOFOLLOW
  UGC
}

/// Logical ad placement slots (§9). External serving is DISABLED by default.
enum AdPlacementSlot {
  HOMEPAGE
  ARTICLE_HEADER
  ARTICLE_INCONTENT
  ARTICLE_FOOTER
  CATEGORY
  RODEO_EVENT
  SIDEBAR
}

/// Entity a commercial relationship/placement attaches to. Keeps the rodeo
/// event-vs-edition separation (§12).
enum CommercialEntityType {
  ARTICLE
  RODEO_HUB
  RODEO_EVENT
  RODEO_EDITION
  DISCIPLINE
  CATEGORY
}

/// Landing-page entity kinds that support editable SEO + FAQs (Batch 11 scope).
enum LandingEntityType {
  DISCIPLINE
  CATEGORY
  RODEO_HUB
  RODEO_EVENT
  RODEO_EDITION
  VENUE
  COMPETITOR
}
