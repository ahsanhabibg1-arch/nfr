# ==============================================================================
# NFRGuide.com — Staging Environment Template
# ==============================================================================
# NEVER paste production secrets here. Each staging deploy must use its own credentials.
#
# HOW THIS MAPS TO RENDER. On Render you do NOT upload this file. render.yaml declares
# every variable; the non-secret ones carry their value there, and the ones marked
# `sync: false` must be typed into the Render dashboard (Service → Environment).
# This file is the reference for WHICH values to paste and what they must look like.
#
# Set in render.yaml already (do not re-enter): NODE_VERSION, NODE_ENV, APP_ENV,
# MEDIA_STORAGE_PROVIDER, LOG_LEVEL, STAGING_NOINDEX.
# Must be entered in the dashboard: NEXT_PUBLIC_SITE_URL, DATABASE_URL,
# INTERNAL_REVALIDATE_SECRET, MEDIA_S3_ENDPOINT, MEDIA_S3_BUCKET, MEDIA_S3_REGION,
# MEDIA_S3_ACCESS_KEY_ID, MEDIA_S3_SECRET_ACCESS_KEY (+ optional APP_VERSION, APP_COMMIT).
#
# NOT set on Render: TEST_DATABASE_URL and CLOUD_DATABASE_URL are local-only (tests and
# migration tooling). BOOTSTRAP_ADMIN_* are used once, from your machine, when creating
# the first staging admin — never stored on the service.

# --- Application Identity ---
APP_ENV="production"
NODE_ENV="production"
NEXT_PUBLIC_SITE_URL="https://nfrguide-staging.onrender.com"

# Staging SEO protection: adds X-Robots-Tag: noindex to all responses.
# Set to "true" on every non-production deployment.
STAGING_NOINDEX="true"

# --- Database (isolated staging instance — NEVER production) ---
DATABASE_URL="postgresql://nfrguide_staging:CHANGE_ME@STAGING_HOST:5432/nfrguide_staging?sslmode=require"

# --- Session / Authentication ---
# No external secret is required — sessions use server-generated random tokens
# with SHA-256 hashing, stored in the Session table. The session cookie is
# HttpOnly + Secure + SameSite=Lax automatically in production mode.

# --- Scheduled publishing (REQUIRED) ---
# Consumed by app/api/internal/revalidate/route.ts and the in-process scheduler
# (lib/cms/scheduledPublishRunner.ts). The endpoint fails CLOSED: if this is unset,
# a scheduled publish still writes to the database but the public pages are NEVER
# revalidated, so the change silently does not appear on the site.
# Use any long random value; it is only used for localhost-to-localhost calls
# inside the instance. Declared in render.yaml as sync:false.
INTERNAL_REVALIDATE_SECRET="CHANGE_ME_LONG_RANDOM_VALUE"

# --- Logging ---
LOG_LEVEL="info"

# --- Media Storage ---
# RENDER FREE REQUIRES R2. The instance filesystem is EPHEMERAL: it is wiped on every
# redeploy, restart and idle spin-down (~15 min), so MEDIA_STORAGE_PROVIDER="local"
# would lose every uploaded image. render.yaml therefore pins this to "r2", and
# lib/env.ts refuses to start in production unless the four R2 values below are set.
# Keep the bucket PRIVATE — delivery is gated through the application's own route.
MEDIA_STORAGE_PROVIDER="r2"
MEDIA_S3_BUCKET="nfrguide-staging-media"
MEDIA_S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
MEDIA_S3_ACCESS_KEY_ID="CHANGE_ME"
MEDIA_S3_SECRET_ACCESS_KEY="CHANGE_ME"
MEDIA_S3_REGION="auto"

# Only for a throwaway local run where losing uploads does not matter:
# MEDIA_STORAGE_PROVIDER="local"

# --- Email (disabled until provider configured) ---
# No email provider is configured by default. Registration and password reset
# still work (tokens are minted + stored) but no email is sent.
# EMAIL_PROVIDER=""
# SENDGRID_API_KEY=""
# EMAIL_FROM="noreply@staging.nfrguide.com"

# --- Analytics (disabled by default on staging) ---
# First-party analytics collection is controlled via Admin → Analytics toggle.
# It defaults to OFF. Do not enable on staging to avoid polluting data.

# --- Monetization (disabled by default) ---
# AdSense and affiliate tracking are admin-toggled. Leave unconfigured on staging.
# NEXT_PUBLIC_ADSENSE_CLIENT=""

# --- Monitoring (optional) ---
# SENTRY_DSN=""

# --- Maintenance escape hatch ---
# APP_MAINTENANCE="1"  # Suppresses env-guard isolation checks for maintenance scripts
