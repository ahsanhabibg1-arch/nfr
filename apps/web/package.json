{
  "name": "nfrguide-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:routes": "tsx scripts/route-smoke.mts",
    "test:cache": "tsx scripts/cache-invalidation.mts",
    "test:migration": "tsx scripts/migration-replay.mts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:setup": "prisma migrate deploy && prisma generate && prisma db seed",
    "db:studio": "prisma studio",
    "bootstrap:admin": "tsx prisma/bootstrap-admin.ts",
    "bootstrap:article-types": "tsx scripts/bootstrap-article-types.ts",
    "bootstrap:classifications": "tsx scripts/bootstrap-discipline-classifications.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
