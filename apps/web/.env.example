# ==============================================================================
# NFRGuide.com (apps/web) — Environment Configuration Template
# ==============================================================================
# Copy to `.env` (git-ignored) for local development. Never commit real secrets.

# --- Public site -------------------------------------------------------------
# Used for canonical URLs, Open Graph, sitemap and robots (lib/seo.ts).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (Batch 02) -----------------------------------------------------
# Server-only. Prisma reads this; it is NEVER exposed to the browser.
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://nfrguide:nfrguide@localhost:5432/nfrguide_dev?schema=public"

# Separate database for integration tests (created/reset by the test harness).
# Point this at a DISPOSABLE database — the test suite truncates it.
TEST_DATABASE_URL="postgresql://nfrguide:nfrguide@localhost:5432/nfrguide_test?schema=public"

# --- Authentication (Batch 03) ----------------------------------------------
# Server-side DB sessions are used (opaque token hashed in the Session table),
# so NO session signing secret is required. Never put secrets in NEXT_PUBLIC_*.
#
# Initial Super Admin bootstrap (`npm run bootstrap:admin`). Prefer the
# interactive prompt (password echo muted). These are only an automation
# fallback — do NOT commit real values; unset them after use:
# BOOTSTRAP_ADMIN_EMAIL=""
# BOOTSTRAP_ADMIN_NAME=""
# BOOTSTRAP_ADMIN_PASSWORD=""

# --- Media / DAM (Batch 05) --------------------------------------------------
# Storage provider for media binaries. Default `local` needs nothing extra.
# `r2` / `s3` activate the S3-compatible adapter (owner-approved target:
# Cloudflare R2) and require the MEDIA_S3_* vars + `npm i @aws-sdk/client-s3`.
MEDIA_STORAGE_PROVIDER="local"

# Local adapter: directory for blobs (git-ignored). Tests override this.
# MEDIA_LOCAL_ROOT="var/media"

# Upload + processing tuning (optional).
# MEDIA_MAX_BYTES="15728640"       # 15 MB
# MEDIA_WEBP_QUALITY="72"          # derivative quality (40-100)

# Cloudflare R2 / S3 (only when MEDIA_STORAGE_PROVIDER=r2|s3). Server-only —
# NEVER expose these to the browser and NEVER commit real values.
# MEDIA_S3_BUCKET=""
# MEDIA_S3_ENDPOINT=""             # R2: https://<account>.r2.cloudflarestorage.com
# MEDIA_S3_REGION="auto"
# MEDIA_S3_ACCESS_KEY_ID=""
# MEDIA_S3_SECRET_ACCESS_KEY=""
# MEDIA_S3_PUBLIC_BASE_URL=""      # CDN / public bucket base, e.g. https://media.nfrguide.com

# ------------------------------------------------------------------------------
# Future batches (not used yet):
# SENTRY_DSN=""                # Error monitoring
