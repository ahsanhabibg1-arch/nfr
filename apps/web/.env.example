# ==============================================================================
# NFRGuide.com (apps/web) — Environment Configuration Template
# ==============================================================================
# Copy to `.env` (git-ignored) for local development. Never commit real secrets.

# --- Runtime / environment (Batch 13) ----------------------------------------
# Explicit environment label used by the env validator + isolation guard
# (lib/env.ts, lib/env-guard.ts). One of: development | test | production.
# Falls back to NODE_ENV when unset. It is NOT trusted alone for DB identity —
# the guard also classifies the actual DATABASE_URL + storage provider.
# APP_ENV="development"
# LOG_LEVEL="info"                 # debug|info — structured JSON logs (lib/logger.ts)
# APP_MAINTENANCE="1"              # ONLY for deliberate maintenance scripts that must
#                                  # touch cloud resources; suppresses the isolation guard.
#                                  # Never set this for the normal app runtime.

# --- Public site -------------------------------------------------------------
# Used for canonical URLs, Open Graph, sitemap and robots (lib/seo.ts).
# In PRODUCTION this must be an https:// URL (enforced by lib/env.ts).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (Batch 02) -----------------------------------------------------
# Server-only. Prisma reads this; it is NEVER exposed to the browser.
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://nfrguide:nfrguide@localhost:5432/nfrguide_dev?schema=public"

# Separate database for integration tests (created/reset by the test harness).
# Point this at a DISPOSABLE database — the test suite truncates it.
TEST_DATABASE_URL="postgresql://nfrguide:nfrguide@localhost:5432/nfrguide_test?schema=public"

# --- Cloud production database (Aiven, infra setup) --------------------------
# OPTIONAL, server-only. The FUTURE deployed site's PostgreSQL (Aiven for
# PostgreSQL, TLS required). This is SEPARATE from local dev — the local
# DATABASE_URL above is NEVER replaced. Prisma migrations are deployed to the
# cloud by running `prisma migrate deploy` with DATABASE_URL set to THIS value
# for that one command (see scripts/cloud-db.mts and AIVEN_CLOUD_DATABASE_SETUP.md).
# Paste the real Aiven URI into your LOCAL .env only — never commit it, never
# share it in chat. The `?sslmode=require` suffix is mandatory (TLS).
# CLOUD_DATABASE_URL="postgresql://avnadmin:PASSWORD@pg-xxxx.aivencloud.com:PORT/defaultdb?sslmode=require"

# --- Authentication (Batch 03) ----------------------------------------------
# Server-side DB sessions are used (opaque token hashed in the Session table),
# so NO session signing secret is required. Never put secrets in NEXT_PUBLIC_*.
#
# Initial Super Admin bootstrap (`npm run bootstrap:admin`). Prefer the
# interactive prompt (password echo muted). These are only an automation
# fallback — do NOT commit real values; unset them after use:
# BOOTSTRAP_ADMIN_EMAIL=""
# BOOTSTRAP_ADMIN_NAME=""
# BOOTSTRAP_ADMIN_PASSWORD=""

# --- Media / DAM (Batch 05) --------------------------------------------------
# Storage provider for media binaries. Default `local` needs nothing extra.
# `r2` / `s3` activate the S3-compatible adapter (owner-approved target:
# Cloudflare R2) and require the MEDIA_S3_* vars + `npm i @aws-sdk/client-s3`.
MEDIA_STORAGE_PROVIDER="local"

# Local adapter: directory for blobs (git-ignored). Tests override this.
# MEDIA_LOCAL_ROOT="var/media"

# Upload + processing tuning (optional).
# MEDIA_MAX_BYTES="15728640"       # 15 MB
# MEDIA_WEBP_QUALITY="72"          # derivative quality (40-100)

# Cloudflare R2 / S3 (only when MEDIA_STORAGE_PROVIDER=r2|s3). Server-only —
# NEVER expose these to the browser and NEVER commit real values. Requires
# `npm i @aws-sdk/client-s3`. Use a BUCKET-SCOPED R2 API token (not account-global).
# For Cloudflare R2 (bucket `nfr`, APAC):
#   MEDIA_S3_ENDPOINT = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   MEDIA_S3_REGION   = auto
# MEDIA_S3_BUCKET=""
# MEDIA_S3_ENDPOINT=""             # R2: https://<account-id>.r2.cloudflarestorage.com
# MEDIA_S3_REGION="auto"
# MEDIA_S3_ACCESS_KEY_ID=""        # NEW rotated token's Access Key ID (bucket-scoped)
# MEDIA_S3_SECRET_ACCESS_KEY=""    # NEW rotated token's Secret Access Key
# MEDIA_S3_PUBLIC_BASE_URL=""      # see CLOUDFLARE_R2_STORAGE_SETUP.md — delivery architecture is
#                                  # an approval gate; keep the bucket PRIVATE and serve via the
#                                  # gated /api/media proxy until a public domain is approved.

# ------------------------------------------------------------------------------
# Future batches (not used yet):
# SENTRY_DSN=""                # Error monitoring
