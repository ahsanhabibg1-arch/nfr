# ==============================================================================
# NFRGuide.com — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# Do NOT commit actual secrets or production credentials to version control.

# Application URL (Used for canonical link generation and self-referential paths)
VITE_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# AI Studio / Assistant integration (optional)
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# Future Phase 1 Production Integration Flags (Not used in Phase 0 UI Prototype)
# ------------------------------------------------------------------------------
# PostgreSQL / Cloud SQL Database Connection String (Phase 1)
# DATABASE_URL="postgresql://nfruser:nfrpass@localhost:5432/nfrguide?schema=public"

# Authentication Secret (NextAuth / JWT, Phase 1)
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"

# Media Storage Bucket (Google Cloud Storage / S3, Phase 1)
# STORAGE_BUCKET_NAME="nfrguide-media-staging"

# Sentry / Error Monitoring DSN (Phase 1)
# SENTRY_DSN=""
